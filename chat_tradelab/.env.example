# ElevenLabs API Configuration
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
ELEVEN_API_KEY=your_elevenlabs_api_key_here
# Alternative name (both work)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Agent IDs
# Create agents at: https://elevenlabs.io/app/conversational-ai
NEXT_PUBLIC_ELEVEN_AGENT_ID_US=your_us_agent_id_here
# NEXT_PUBLIC_ELEVEN_AGENT_ID_CA=your_canada_agent_id_here
# NEXT_PUBLIC_ELEVEN_AGENT_ID_MX=your_mexico_agent_id_here
# NEXT_PUBLIC_ELEVEN_AGENT_ID_EU=your_eu_agent_id_here

# Optional: Backend API URL (if using existing Render backend)
# BACKEND_BASE_URL=https://your-backend.onrender.com
